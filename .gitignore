release/NEXUS_SUPPORT_EMAIL_NACHTRAG.txt
release/NEXUS_SUPPORT_EMAIL_NACHTRAG2.txt
release/ZILLYA_FALSE_POSITIVE.txt
# Internes Testprotokoll und der jederzeit neu erzeugbare Nexus-Header
TESTPROTOKOLL.md
release/NEXUS_HEADER.png
release/NEXUS_SUPPORT_EMAIL_NACHTRAG.txt

# Proprietary Oodle DLL (fetched at runtime, never redistributable).
# Deliberately without a .dll suffix so half-finished downloads
# (oo2core_9_win64.dll.<pid>.part) can never slip into a commit either.
tools/oo2core*
.s2tweaker_write_test
**/.s2tweaker_write_test

# Build artifacts
build/
dist/
__pycache__/
*.spec
release/*.zip

# Stray test paks
*.pak

# Screenshots: jederzeit per tools/make_screenshots.py neu erzeugbar
release/screenshots/
tests/_tmp/
tests/_tmp/

# Interne Arbeitsdokumente: bleiben LOKAL im Ordner, nie auf GitHub.
# Sie enthalten Rechnernamen, Benutzerpfade, private Notizen und interne
# Vorgaenge (u. a. die Nexus-Moderation, die der Staff ausdruecklich nicht
# oeffentlich diskutiert sehen will). Wandern zwischen den Rechnern mit dem
# Ordner, nicht ueber das Repo.
HANDOVER.md
docs/ROADMAP.md
.claude/
release/NEXUS_REPLIES.txt
release/DEFENDER_FALSE_POSITIVE.txt
release/SIGNPATH_APPLICATION.txt
release/ISSUE_6_ANTWORT.txt

# Nexus-Icon (Meme-Gesichter, nur lokal; NEXUS_ICON.png jederzeit per tools/make_icon.py neu)
release/NEXUS_ICON*.png
